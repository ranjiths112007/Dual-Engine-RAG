# ============================================================
# Dual-Engine RAG Configuration Example
# ============================================================

# Database (PostgreSQL port 5433)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/dual_engine_rag

# ChromaDB Vector Store (port 8002)
CHROMA_HOST=localhost
CHROMA_PORT=8002

# ===========================================
# LLM Provider: "gemini" | "ollama"
# ===========================================

# --- Gemini (active) ---
LLM_PROVIDER=gemini
GOOGLE_AI_API_KEY=your-gemini-api-key
LLM_MODEL_FAST=gemini-3.5-flash

# Thinking level for Gemini 3.x+: "minimal" | "low" | "medium" | "high"
LLM_THINKING_LEVEL=medium

# Max output tokens for chat (includes thinking tokens)
LLM_MAX_OUTPUT_TOKENS=8192

# --- Ollama (inactive - uncomment to use local models) ---
# LLM_PROVIDER=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen3.5:9b
# OLLAMA_ENABLE_THINKING=false

# ===========================================
# Knowledge Graph Embedding Provider
# ===========================================

# --- KG Embedding: Gemini (active) ---
KG_EMBEDDING_PROVIDER=gemini
KG_EMBEDDING_MODEL=gemini-embedding-001
KG_EMBEDDING_DIMENSION=3072

# --- KG Embedding: Sentence-Transformers (inactive — local alternative) ---
# KG_EMBEDDING_PROVIDER=sentence_transformers
# KG_EMBEDDING_MODEL=BAAI/bge-m3
# KG_EMBEDDING_DIMENSION=1024

# ===========================================
# Dual-Engine RAG Pipeline Configuration
# ===========================================
DUAL_ENGINE_RAG_ENABLED=true
DUAL_ENGINE_RAG_ENABLE_KG=true
DUAL_ENGINE_RAG_KG_LANGUAGE=English
DUAL_ENGINE_RAG_KG_ENTITY_TYPES=["Organization","Person","Product","Location","Event","Financial_Metric","Technology","Date","Regulation"]

# Document Parser: "docling" (default) or "marker"
DUAL_ENGINE_RAG_DOCUMENT_PARSER=docling
DUAL_ENGINE_RAG_ENABLE_IMAGE_EXTRACTION=true
DUAL_ENGINE_RAG_ENABLE_IMAGE_CAPTIONING=true

# Embedding & Reranking Models
DUAL_ENGINE_RAG_EMBEDDING_MODEL=BAAI/bge-m3
DUAL_ENGINE_RAG_RERANKER_MODEL=BAAI/bge-reranker-v2-m3
DUAL_ENGINE_RAG_CHUNK_MAX_TOKENS=512
DUAL_ENGINE_RAG_VECTOR_PREFETCH=20
DUAL_ENGINE_RAG_RERANKER_TOP_K=8
DUAL_ENGINE_RAG_MIN_RELEVANCE_SCORE=0.15

# Processing timeout in minutes
DUAL_ENGINE_RAG_PROCESSING_TIMEOUT_MINUTES=10

# Pre-ingestion Deduplication
DUAL_ENGINE_RAG_DEDUP_ENABLED=true
DUAL_ENGINE_RAG_DEDUP_MIN_CHUNK_LENGTH=50
DUAL_ENGINE_RAG_DEDUP_NEAR_THRESHOLD=0.85

# CORS Origins
CORS_ORIGINS=["http://localhost:5174","http://localhost:3000"]
